# Native (no-Docker) local dev environment. Generated for this sandbox since
# Docker Desktop isn't available — everything points at localhost instead of
# docker-compose service names. Source this before running the control-plane
# or web app directly: `set -a; source .env.native; set +a`

APP_ENV=dev

# === LLM — pointed at the locally-running Ollama instead of OpenAI ===
LLM_PROVIDER=ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_GENERAL=gpt-oss:20b
OLLAMA_MODEL_CODE=qwen2.5-coder:14b

# === Database (native Postgres 17 + pgvector, port 5432) ===
DATABASE_URL=postgres://nexis:nexis_dev_password@localhost:5432/nexis?sslmode=disable
DATABASE_URL_APP=postgres://nexis_app:nexis_app_dev_password@localhost:5432/nexis?sslmode=disable

# === Auth ===
AUTH_PROVIDER=local
ALLOW_STUB_WORKOS=0
SESSION_SECRET=dev-session-secret-replace-in-prod-32
AUDIT_SECRET=dev-audit-secret-replace-in-prod-32
APP_BASE_URL=http://localhost:3000

# === Mail (no local MailHog — mail sends will fail soft in dev) ===
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_FROM=no-reply@nexis.local

# === Service URLs (native ports) ===
CONTROL_PLANE_URL=http://localhost:8080
VALIDATOR_URL=http://localhost:8081
GITOPS_URL=http://localhost:8082

# === Web ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080
API_URL_INTERNAL=http://localhost:8080

# === Observability (disabled — no local collector) ===
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=control-plane
LOG_LEVEL=info

# === Master key ===
MASTER_KEY=dGVzdC1tYXN0ZXIta2V5LTMyLWJ5dGVzLWxvbmctYWFh
GITHUB_WEBHOOK_SECRET=dev-github-webhook-secret-32-byte

# === Temporal (native dev server, port 7233) ===
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=nexis-recovery
VALIDATOR_TOKEN=dev-validator-token-32byte
PATCH_STORE=minio
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=nexis
MINIO_SECRET_KEY=nexis_dev_password
MINIO_USE_SSL=0
WORKFLOW_STUB_DURATION_MS=0

# === GitOps + GitHub App (no real GitHub App in this sandbox) ===
GITOPS_TOKEN=dev-gitops-token-32byte
GITHUB_APP_ID=12345
FIXTURE_REPO_OWNER=nexis-eco
FIXTURE_REPO_NAME=fixture-recovery-demo
FIXTURE_REPO_DEFAULT_BRANCH=main
FIXTURE_REPO_INSTALLATION_ID=98765

# === Deploy-engine sidecar (Docker preview deploys, port 8091) ===
DEPLOY_ENGINE_URL=http://localhost:8091
DEPLOY_ENGINE_TOKEN=dev-deploy-engine-token-32byte

# === Sentinel + agents ===
SENTINEL_ENABLED=1
SENTINEL_POLL_INTERVAL_MS=10000
CAUSAL_ENABLED=1
PATHFINDER_LLM_REFINE=0
SLACK_ENABLED=0
APPROVAL_MEDIUM_TIMEOUT_SECONDS=120

# === Neo4j (native, port 7687) ===
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASS=nexis_dev_password

# === Redis (native, port 6379) ===
REDIS_ADDR=localhost:6379
