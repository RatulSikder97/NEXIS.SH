# build artifacts
node_modules/
.next/
out/
dist/
.turbo/
*.log

# go
/services/*/bin/
/services/*/coverage.out
/services/*/.air.tmp/

# env / secrets
.env
.env.local
.env.*.local
.envrc.local

# secret material — only *.example placeholders may be checked in
secrets/*.pem
secrets/*.key
secrets/*.crt
!secrets/*.example
# `secret/` (singular) is a common typo for the directory above — ignore the
# whole thing so a GitHub App key dropped there can never be committed.
secret/
*.private-key.pem

# OS / editor
.DS_Store
.idea/
.vscode/
*.swp

# legacy + local TLS
_legacy/
infra/tls/cert.pem
infra/tls/key.pem
infra/tls/*.crt
infra/tls/*.key

# docker volumes
.docker-data/
__pycache__/
*.pyc

# native dev stack runtime (pids, logs, built binaries)
.run/
