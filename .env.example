# NEXIS ECO — local dev environment template.
#
# Bootstrap:
#   cp .env.example .env
#   cp secrets/github-app.pem.example secrets/github-app.pem   # paste your GitHub App private key, or leave empty for dev
#   docker compose up -d
#
# The values below are SAFE-TO-COMMIT placeholders. They are *not* real
# production secrets — they are only long enough to pass length checks in
# the control-plane config loader. Rotate every secret before any non-dev
# deployment. docker-compose.yml uses `${VAR:?...}` for the critical
# secrets so the stack will refuse to boot if you forget to copy this
# file to `.env`.

# === LLM ===
LLM_PROVIDER=openai                              # openai | ollama
OPENAI_API_KEY=sk-replace-me
OPENAI_MODEL_SYNTHESIS=gpt-4o
OPENAI_MODEL_CHEAP=gpt-4o-mini
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL_GENERAL=llama3.1:8b
OLLAMA_MODEL_CODE=qwen2.5-coder:14b              # optional

# === Database ===
# DATABASE_URL: superuser/owner — used for migrations and pre-tenant operations
# DATABASE_URL_APP: nexis_app non-superuser — used for RLS-bound request queries
DATABASE_URL=postgres://nexis:nexis_dev_password@postgres:5432/nexis?sslmode=disable
DATABASE_URL_APP=postgres://nexis_app:nexis_app_dev_password@postgres:5432/nexis?sslmode=disable

# === Auth (Phase 2) ===
AUTH_PROVIDER=local                              # local | workos (workos is stub in Phase 2)
ALLOW_STUB_WORKOS=0                              # 1 to let AUTH_PROVIDER=workos fall through to local
SESSION_SECRET=dev-session-secret-replace-in-prod-32   # 32-byte base64 in prod
AUDIT_SECRET=dev-audit-secret-replace-in-prod-32       # 32-byte base64 in prod
APP_BASE_URL=http://localhost:3000

# === Mail (dev = MailHog) ===
SMTP_HOST=mailhog
SMTP_PORT=1025
SMTP_FROM=no-reply@nexis.local

# === Service URLs (inside docker network) ===
CONTROL_PLANE_URL=http://control-plane:8080
VALIDATOR_URL=http://validator:8081
GITOPS_URL=http://gitops:8082

# === Web ===
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8080

# === Observability ===
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
OTEL_SERVICE_NAME=control-plane
LOG_LEVEL=info

# === Master key (Phase 3) — encrypts integration secrets at rest ===
MASTER_KEY=dGVzdC1tYXN0ZXIta2V5LTMyLWJ5dGVzLWxvbmctYWFh
GITHUB_WEBHOOK_SECRET=dev-github-webhook-secret-32-byte

# === Phase 4 — pipeline substrate ===
TEMPORAL_HOST_PORT=temporal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=nexis-recovery
VALIDATOR_TOKEN=dev-validator-token-32byte
PATCH_STORE=minio
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=nexis
MINIO_SECRET_KEY=nexis_dev_password
MINIO_USE_SSL=0
# When >0, each stub activity sleeps this long. Set 0 for fast tests.
WORKFLOW_STUB_DURATION_MS=0

# === Phase 6 — GitOps + GitHub App ===
GITOPS_TOKEN=dev-gitops-token-32byte             # bearer token control-plane -> gitops
GITHUB_APP_ID=12345
FIXTURE_REPO_OWNER=nexis-eco
FIXTURE_REPO_NAME=fixture-recovery-demo
FIXTURE_REPO_DEFAULT_BRANCH=main
FIXTURE_REPO_INSTALLATION_ID=98765

# === Phase 6 — Sentinel + agents ===
SENTINEL_ENABLED=1
SENTINEL_POLL_INTERVAL_MS=10000
CAUSAL_ENABLED=1
PATHFINDER_LLM_REFINE=0
SLACK_ENABLED=1
APPROVAL_MEDIUM_TIMEOUT_SECONDS=120

# === Preview deployments — deploy-engine ===
DEPLOY_ENGINE_TOKEN=dev-deploy-engine-token-32b   # bearer token control-plane -> deploy-engine
